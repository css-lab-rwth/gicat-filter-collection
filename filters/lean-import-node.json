{
	"packageName": "Lean Import Node Filter",
	"authors": "CSS-Lab RWTH Aachen University",
	"desc": "A node filter to visualize module imports in the Lean programming language.",
	"date": "2024-01-31T16:44:59.958Z",
	"nodeFilterList": [
		{
			"name": "Import Node Filter",
			"regex": "/import\\s+(\\S+)\\s*\\n*/gm",
			"id": "importFilter",
			"spec": "node",
			"exclude": [""],
			"extension": ".lean",
			"attributes": {
				"moduleName": [1]
			},
			"style": {
				"color": "#6461F9"
			},
			"failures": [""],
			"label": "Import",
			"labelAttribute": "moduleName"
		}
	],
	"edgeFilterList": [
	]
}