{
	"packageName": "Java Class Extension Filter Package",
	"authors": "CSSLab RWTH Aachen University",
	"desc": "A filter package to visualize class extensions in the Java programming language.",
	"date": "2024-09-02T15:14:44.257Z",
	"nodeFilterList": [
		{
			"name": "Java Class Extension Node Filter",
			"regex": "/(?<!\\*[\\w\\s]*)class\\s(\\w+)(\\sextends\\s(\\w+))?\\s?/gm",
			"id": "javaClassExtensionFilter",
			"spec": "node",
			"exclude": [
				""
			],
			"extension": ".java",
			"attributes": {
				"className": [
					1
				],
				"extends": [
					3
				]
			},
			"style": {
				"color": "#6461F9"
			},
			"failures": [
				""
			],
			"label": "Class",
			"labelAttribute": "className"
		}
	],
	"edgeFilterList": [
		{
			"allow-loop": true,
			"mode": "strict",
			"label": "extends",
			"spec": "edge",
			"name": "Class Extension Edge Filter Java",
			"id": "classExtensionEdgeFilter",
			"from": {
				"nodeFilterID": "javaClassExtensionFilter",
				"attribute": "extends"
			},
			"to": {
                "nodeFilterID": "javaClassExtensionFilter",
                "attribute": "className"
            },
            "style":{
                "color": "#F76262"
        	}
		}
	]
}