{
	"packageName": "OCaml Module Node Filter",
	"authors": "CSSLab RWTH Aachen University",
	"desc": "This node filter aims to visualize module imports for the OCaml programming language.",
	"date": "2024-09-02T15:14:44.257Z",
	"nodeFilterList": [
		{
			"name": "Module Import Node Filter",
			"regex": "/module\\s(\\S+)\\s*=\\s*(\\S+)/gm",
			"id": "moduleimportFilter",
			"spec": "node",
			"exclude": [
				""
			],
			"extension": ".ml",
			"attributes": {
                "moduleName": [2]
			},
			"style": {
				"color": "#6461F9"
			},
			"failures": [
				""
			],
			"label": "Module",
			"labelAttribute": "moduleName"
		}
	],
	"edgeFilterList": [
	]
}