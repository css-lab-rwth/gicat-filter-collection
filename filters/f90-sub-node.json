{
	"packageName": "Fortran90 Subroutine Calls Node Filter Package",
	"authors": "CSS-Lab RWTH Aachen University",
	"desc": "A filter package to visualize subroutine definitions and subroutine calls for the Fortran90 programming language. These filters however might work for different Fortran versions without any guarantees.",
	"date": "2024-09-02T15:14:44.257Z",
	"nodeFilterList": [
		{
			"name": "Subroutine Node Filter",
			"regex": "/.*\\sSUBROUTINE\\s*(.+\\s?)\\(/gm",
			"id": "subroutineFilter",
			"spec": "node",
			"exclude": [
				""
			],
			"extension": ".f90",
			"attributes": {
				"subroutine": [
					1
				]
			},
			"style": {
				"color": "#6461F9"
			},
			"failures": [
				""
			],
			"label": "Subroutine",
			"labelAttribute": "subroutine"
		},
		{
			"name": "Call Node Filter",
			"regex": "/CALL\\s(\\w+)\\w*\\(/gmi",
			"id": "callFilter",
			"spec": "node",
			"exclude": [
				""
			],
			"extension": ".f90",
			"attributes": {
				"call": [
					1
				]
			},
			"style": {
				"color": "#EBBB71"
			},
			"failures": [
				""
			],
			"label": "CALL",
			"labelAttribute": "call"
		}
	],
	"edgeFilterList": [
	]
}