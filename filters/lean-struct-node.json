{
	"packageName": "Lean Structure Node Filter",
	"authors": "CSSLab RWTH Aachen University",
	"desc": "A node filter to visualize structure definitions in the Lean programming language.",
	"date": "2024-01-31T16:44:59.958Z",
	"nodeFilterList": [
		{
			"name": "Structure Node Filter",
			"regex": "/structure\\s+(\\S+)\\s+where\\s*/gm",
			"id": "structureFilter",
			"spec": "node",
			"exclude": [""],
			"extension": ".lean",
			"attributes": {
				"structureName": [1]
			},
			"style": {
				"color": "#F76262"
			},
			"failures": [""],
			"label": "Structure",
			"labelAttribute": "structureName"
		}
	],
	"edgeFilterList": [
	]
}