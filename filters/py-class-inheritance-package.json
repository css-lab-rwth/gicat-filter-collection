{
	"packageName": "Python Class Inheritance Filter package",
	"authors": "CSSLab RWTH Aachen University",
	"desc": "This filter package aims to visualize the class inheritance of Python Classes. It therefore uses a Class Node Filter which is looking to visualize all class definitions as nodes. It also contains an Edge Filter which draws edges between the child class (source) to its parent class (target).",
	"date": "2024-01-31T16:44:59.958Z",
	"nodeFilterList": [
		{
			"name": "Class Node Filter",
			"regex": "/class ([A-Za-z]+)\\(?(.*)\\)?\\:/gm",
			"id": "classFilterPython",
			"spec": "node",
			"extension": ".py",
			"attributes": {
				"className": [
					1
				],
				"extends": [
					2
				]
			},
			"style": {
				"color": "#6461F9"
			},
			"failures": [
				""
			],
			"label": "Class",
			"labelAttribute": "className"
		}
	],
	"edgeFilterList": [
		{
			"allow-loop": true,
			"mode": "contains",
			"label": "extends",
			"spec": "edge",
			"name": "Class Edge Filter",
			"id": "class-EdgeFilterPython",
			"from": {
				"nodeFilterID": "classFilterPython",
				"attribute": "extends"
			},
			"to": {
				"nodeFilterID": "classFilterPython",
				"attribute": "className"
			},
			"style": {
				"color": "#BA33E2"
			}
		}
	]
}